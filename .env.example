# ─── ServerCat Environment Configuration ────────────────────────
# Copy this file to .env and fill in the values.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.

# ── Database ─────────────────────────────────────────────────────
DB_NAME=servercat
DB_USER=servercat_app
# REQUIRED — set a strong password
DB_PASSWORD=change-me-before-use

# ── Application ───────────────────────────────────────────────────
# REQUIRED — at least 32 random characters; used to sign JWTs
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Token lifetime in hours (default: 8)
JWT_EXPIRY_HOURS=8

# Port to expose the app on (dev only; prod uses Nginx on 443)
APP_PORT=8080

# Environment (Development enables Swagger UI and detailed errors)
APP_ENV=Development

# ── Polling ───────────────────────────────────────────────────────
# Max simultaneous WinRM/SNMP polls
POLLING_CONCURRENCY=10

# ── Notes ─────────────────────────────────────────────────────────
# After starting, load seed data with:
#   docker compose exec db psql -U $DB_USER -d $DB_NAME -f /scripts/seed.sql
# (mount scripts/ dir if you want to run seed in the container)
